{
  "version": 1,
  "sdk_version": "2.0.2",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://yefirfntonzzywegytyl.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "umraio-autonomous-a-i",
      "version": "0.1.0",
      "title": "UMRAIO Autonomous A.I"
    },
    "tools": [
      {
        "name": "list_leads",
        "title": "List leads",
        "description": "List the agency's Umrah leads, newest first. Optionally filter by stage, temperature or a name/phone/email search.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "search": {
              "description": "Match on name, phone or email.",
              "type": "string",
              "minLength": 1
            },
            "stage": {
              "description": "Lead stage, e.g. new or qualified.",
              "type": "string",
              "minLength": 1
            },
            "temperature": {
              "description": "Lead temperature, e.g. hot.",
              "type": "string",
              "minLength": 1
            },
            "limit": {
              "default": 20,
              "description": "How many leads to return.",
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "get_lead",
        "title": "Get lead details",
        "description": "Fetch one lead with its recent internal notes and upcoming appointments, by lead id.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "lead_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "The lead's id."
            }
          },
          "required": [
            "lead_id"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "list_conversation_messages",
        "title": "Read a conversation",
        "description": "Read the recent WhatsApp conversation messages for a lead, oldest to newest, so you can summarise what was discussed.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "lead_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "The lead whose conversation should be read."
            },
            "limit": {
              "default": 30,
              "description": "How many messages to return.",
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          "required": [
            "lead_id"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "list_packages",
        "title": "List Umrah packages",
        "description": "List the agency's Umrah packages with pricing, hotels, airline and inclusions.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "active_only": {
              "default": true,
              "description": "Only return packages currently on sale.",
              "type": "boolean"
            },
            "limit": {
              "default": 25,
              "description": "How many packages to return.",
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "list_bookings",
        "title": "List bookings",
        "description": "List the agency's Umrah bookings with amounts, deposit status and pax, newest first.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "status": {
              "description": "Filter by booking status.",
              "type": "string",
              "minLength": 1
            },
            "limit": {
              "default": 25,
              "description": "How many bookings to return.",
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "add_lead_note",
        "title": "Add an internal lead note",
        "description": "Add an internal note to a lead. Notes are visible to the agency team only and are never sent to the customer.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "lead_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "The lead to attach the note to."
            },
            "body": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000,
              "description": "The note text."
            }
          },
          "required": [
            "lead_id",
            "body"
          ]
        },
        "outputSchema": null
      }
    ]
  }
}
